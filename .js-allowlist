# Served to the browser as-is, and written by the container at startup.
public/config.js

# Addon samples people copy. The client loads an addon's files as they are, so they're JavaScript.
examples/presence/index.js
examples/presence/source.mjs

# eslint 8 reads its config only from JavaScript.
.eslintrc.cjs

# The Windows signing hook, what it imports, and the check that loads it. Only a Windows build runs them (GRYT-1800).
scripts/check-windows-signature.mjs
scripts/sign-windows.cjs
scripts/windows-signature.mjs
