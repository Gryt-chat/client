# Served to the browser as-is, and written by the container at startup.
public/config.js

# Addon samples people copy. The client loads an addon's files as they are, so they're JavaScript.
examples/presence/index.js
examples/presence/source.mjs

# eslint 8 reads its config only from JavaScript.
.eslintrc.cjs

# electron-builder loads these itself, as its config and hooks, plus what they import and a check that loads them.
# Only a real desktop build shows whether it takes TypeScript, so they wait for one (GRYT-1800).
electron-builder.config.cjs
scripts/build-helper.mjs
scripts/check-extra-resources.mjs
scripts/check-windows-signature.mjs
scripts/notarize.cjs
scripts/package-embedded-server.mjs
scripts/prepare-electron-build.mjs
scripts/prune-prebuilds.cjs
scripts/sign-windows.cjs
scripts/variant.mjs
scripts/windows-signature.mjs
